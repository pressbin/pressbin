meta {
  name: Upload Asset (JSON)
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/sync/asset
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "path": "{{assetPath}}",
    "content_base64": ""
  }
}

docs {
  Upload an asset using JSON + base64 (same format as the GitHub Action `push_asset.py` script).
  
  - `path`: relative path under the assets root, e.g. `images/logo.svg` (no leading `assets/`)
  - `content_base64`: file bytes encoded as standard base64
  
  Response: `{ "status": "ok", "path": "...", "action": "created" | "updated" }`
}

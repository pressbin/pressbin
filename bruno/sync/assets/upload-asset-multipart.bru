meta {
  name: Upload Asset (Multipart)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/sync/asset
  body: multipartForm
  auth: inherit
}

body:multipart-form {
  path: {{assetPath}}
  file: @file(../../fixtures/sample.svg)
}

docs {
  Alternative upload using `multipart/form-data` with fields:
  - `path` — relative asset path (e.g. `images/pressbin-sync-flow.svg`)
  - `file` — the file to upload
  
  Max size: 5 MiB.
}

# Pressbin Configuration (optional)
#
# Use config.yml and/or PRESSBIN_* environment variables. Env vars win when both are set.
#
# Recommended user install (no root):
#   curl -fsSL https://raw.githubusercontent.com/pressbin/pressbin/main/scripts/install.sh | bash -s -- --site-url https://blog.example.com
#
# That creates ~/.pressbin/:
#   bin/pressbin          binary
#   config.yml            this file
#   data/pressbin.db      database
#   assets/               blog static files (/assets/*)
#   admin.key             admin API key (cannot sync)
#   sync.key              GitHub sync key (cannot access admin API)
#
# Environment variables:
#   PRESSBIN_SERVER_PORT          server.port
#   PRESSBIN_SERVER_HOST          server.host
#   PRESSBIN_DATABASE_PATH        database.path
#   PRESSBIN_SITE_TITLE           site.title
#   PRESSBIN_SITE_DESCRIPTION     site.description
#   PRESSBIN_SITE_URL             site.url
#   PRESSBIN_SITE_POSTS_PER_PAGE  site.posts_per_page
#   PRESSBIN_ASSETS_PATH          assets.path
#   PRESSBIN_LOG_LEVEL            log.level

server:
  port: 8080
  host: 127.0.0.1

database:
  path: ./data/pressbin.db

site:
  title: "My Blog"
  description: "Writing about things."
  url: "https://yourdomain.com"
  posts_per_page: 10

# Blog assets: synced via API, served at /assets/*
# Must not be the binary or database directory.
assets:
  path: ./assets

log:
  level: info
